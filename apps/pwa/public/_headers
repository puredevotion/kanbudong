# Cloudflare Pages header rules. The only thing that matters here is that the
# service worker and the shell are never served stale: registerType is
# 'autoUpdate', and a cached sw.js would pin a device to an old question pack,
# which the protocol then refuses to play against a device on the new one.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

# Vite content-hashes everything under /assets, so these are safe to pin
# forever - a new build produces new filenames.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
