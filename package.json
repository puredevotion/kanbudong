{
  "name": "kanbudong",
  "version": "0.1.0",
  "private": true,
  "description": "看不懂 — a co-located multiplayer Mandarin reading game",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "install:web": "pnpm install --filter @kanbudong/pwa... --filter @kanbudong/engine... --filter @kanbudong/net...",
    "typecheck": "pnpm -r --filter @kanbudong/engine --filter @kanbudong/net --filter @kanbudong/pwa typecheck",
    "test": "pnpm --filter @kanbudong/engine --filter @kanbudong/net --filter @kanbudong/pwa test",
    "fonts": "node scripts/install-fonts.mjs",
    "fonts:subset": "python3 scripts/build-fonts.py",
    "strokes": "node scripts/build-strokes.mjs",
    "build": "pnpm fonts && pnpm strokes && pnpm --filter @kanbudong/pwa build",
    "dev": "pnpm --filter @kanbudong/pwa dev",
    "lint": "oxlint . && node scripts/check-no-glyph-match.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
