{
  "name": "kanbudong",
  "version": "0.1.0",
  "private": true,
  "description": "看不懂 — a co-located multiplayer Mandarin reading game",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:web": "pnpm install --filter @kanbudong/pwa... --filter @kanbudong/engine... --filter @kanbudong/net...",
    "typecheck": "pnpm -r --filter @kanbudong/engine --filter @kanbudong/net --filter @kanbudong/pwa --filter @kanbudong/native typecheck",
    "test": "pnpm --filter @kanbudong/engine --filter @kanbudong/net test",
    "build": "pnpm --filter @kanbudong/pwa build",
    "dev": "pnpm --filter @kanbudong/pwa dev",
    "lint": "oxlint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
